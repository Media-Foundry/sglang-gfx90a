  "passed": true,
  "query": "WITH ordered AS (\n  SELECT\n    user_id,\n    ts,\n    id,\n    LAG(ts) OVER (PARTITION BY user_id ORDER BY ts, id) AS prev_ts\n  FROM events\n),\nflagged AS (\n  SELECT\n    user_id,\n    ts,\n    id,\n    CASE\n      WHEN prev_ts IS NULL THEN 0\n      WHEN ts - prev_ts > 1800 THEN 1\n      ELSE 0\n    END AS new_session\n  FROM ordered\n),\nnumbered AS (\n  SELECT\n    user_id,\n    ts,\n    SUM(new_session) OVER (\n      PARTITION BY user_id\n      ORDER BY ts, id\n      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW\n    ) + 1 AS session_no\n  FROM flagged\n)\nSELECT\n  user_id,\n  session_no,\n  MIN(ts) AS start_ts,\n  MAX(ts) AS end_ts,\n  COUNT(*) AS event_count\nFROM numbered\nGROUP BY user_id, session_no\nORDER BY user_id, session_no;",
