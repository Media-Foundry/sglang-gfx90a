@@ -33,6 +33,18 @@ if(NOT TARGET numa::numa)
 endif()
 
 find_package(hsakmt REQUIRED)
+# ROCm's RPM-built hsakmt export hard-codes /usr/lib64/libc.so.  Remap that
+# imported link item on Debian-family hosts instead of requiring a system-wide
+# compatibility symlink.
+if(TARGET hsakmt::hsakmt AND NOT EXISTS "/usr/lib64/libc.so")
+  find_library(MORI_SYSTEM_LIBC NAMES c REQUIRED)
+  get_target_property(_hsakmt_link_libraries hsakmt::hsakmt
+                      INTERFACE_LINK_LIBRARIES)
+  list(TRANSFORM _hsakmt_link_libraries REPLACE "^/usr/lib64/libc\\.so$"
+       "${MORI_SYSTEM_LIBC}")
+  set_target_properties(hsakmt::hsakmt PROPERTIES
+                        INTERFACE_LINK_LIBRARIES "${_hsakmt_link_libraries}")
+endif()
